# Crimson line-ending and diff policy.
#
# Crimson is a Windows-first native project, so text files are checked out
# CRLF but normalized to LF in the object store.
#
# The important rule is at the bottom: protocol and message test fixtures must
# NEVER be line-ending converted. IMAP literals, SMTP dot-stuffing and RFC 5322
# parsing all depend on exact CRLF placement, and several fixtures deliberately
# contain bare LF or bare CR to exercise malformed input. Normalizing those
# would silently rewrite the thing under test.

* text=auto eol=crlf

# --- Sources and docs -------------------------------------------------------
*.c      text eol=crlf
*.cc     text eol=crlf
*.cpp    text eol=crlf
*.h      text eol=crlf
*.hpp    text eol=crlf
*.inl    text eol=crlf
*.md     text eol=crlf
*.txt    text eol=crlf
*.json   text eol=crlf
*.yml    text eol=crlf
*.yaml   text eol=crlf

# --- MSVC project files (the toolchain writes CRLF; keep it stable) ---------
*.sln       text eol=crlf
*.vcxproj   text eol=crlf
*.filters   text eol=crlf
*.props     text eol=crlf
*.targets   text eol=crlf
*.rc        text eol=crlf
*.manifest  text eol=crlf

# --- Scripts that must stay LF ---------------------------------------------
*.sh   text eol=lf
*.bash text eol=lf

# --- Binary assets ---------------------------------------------------------
*.png  binary
*.jpg  binary
*.jpeg binary
*.gif  binary
*.ico  binary
*.pdf  binary
*.zip  binary
*.ttf  binary
*.otf  binary
*.pdb  binary
*.lib  binary
*.exe  binary
*.dll  binary

# --- Test fixtures: byte-exact, never converted, never diffed as text ------
tests/**/fixtures/**  -text -diff
tests/**/corpus/**    -text -diff
*.eml                 -text -diff
*.mime                -text -diff
*.imap                -text -diff
*.smtp                -text -diff
*.raw                 -text -diff

# --- Generated / vendored files excluded from language statistics ----------
LICENSE linguist-vendored
