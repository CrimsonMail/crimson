<?xml version="1.0" encoding="utf-8"?>
<Project DefaultTargets="Build" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <ItemGroup Label="ProjectConfigurations">
    <ProjectConfiguration Include="Debug|x64">
      <Configuration>Debug</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
    <ProjectConfiguration Include="Release|x64">
      <Configuration>Release</Configuration>
      <Platform>x64</Platform>
    </ProjectConfiguration>
  </ItemGroup>

  <!-- A libFuzzer target for the IMAP parser. See ADR 0013.

       Deliberately not in Crimson.sln: it builds with the fuzzer and
       AddressSanitizer, which ordinary pull request builds do not need to pay
       for. Build and run it with scripts\fuzz.cmd.

       The tokenizer's sources are compiled here directly rather than linked
       from Crimson.Protocols.lib. libFuzzer steers by coverage, and only code
       compiled with /fsanitize=fuzzer reports coverage; a prebuilt library
       would be a black box to it. -->
  <PropertyGroup Label="Globals">
    <ProjectGuid>{6F3D9A27-1C4E-4A5B-9E8D-0B7F2A16C3D4}</ProjectGuid>
    <RootNamespace>crimson</RootNamespace>
    <WindowsTargetPlatformVersion>10.0</WindowsTargetPlatformVersion>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.Default.props" />
  <Import Project="$(MSBuildThisFileDirectory)..\..\build\Crimson.Toolset.props" />

  <PropertyGroup Label="Configuration">
    <ConfigurationType>Application</ConfigurationType>
    <CharacterSet>Unicode</CharacterSet>
    <EnableASAN>true</EnableASAN>
  </PropertyGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.props" />

  <ImportGroup Label="PropertySheets">
    <Import Project="$(MSBuildThisFileDirectory)..\..\build\Crimson.Common.props" />
  </ImportGroup>

  <PropertyGroup>
    <TargetName>crimson-fuzz-imap-parser</TargetName>
  </PropertyGroup>

  <ItemDefinitionGroup>
    <ClCompile>
      <AdditionalOptions>/fsanitize=fuzzer %(AdditionalOptions)</AdditionalOptions>
      <!-- tests\ for imap\imap_test_support.h, shared with the test suite so
           the fuzzer checks exactly the properties the tests do. -->
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
    <Link>
      <SubSystem>Console</SubSystem>
    </Link>
  </ItemDefinitionGroup>

  <ItemGroup>
    <ClCompile Include="imap_parser_fuzz.cpp" />
    <ClCompile Include="..\..\src\protocols\imap\lexer.cpp" />
    <ClCompile Include="..\..\src\protocols\imap\parser.cpp" />
    <ClCompile Include="..\..\src\protocols\imap\response.cpp" />
    <ClCompile Include="..\..\src\protocols\imap\response_reader.cpp" />
  </ItemGroup>

  <Import Project="$(VCTargetsPath)\Microsoft.Cpp.targets" />
</Project>
